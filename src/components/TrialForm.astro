---
import { SITE_DATA } from '../constants';

const siteKey = SITE_DATA.trialSiteKey;
const apiBase = SITE_DATA.trialApiBase;
---

<div class="trial-form-wrap">
  <div id="trial-form-section" class="trial-form-card">
    <h2 class="trial-form-title">Dùng thử 30 ngày</h2>
    <p class="trial-form-sub">Nhập email chính xác để nhận link tải ISO — link có hiệu lực 24 giờ, tối đa 3 lượt tải.</p>

    <form id="trial-form" novalidate>
      <label class="trial-form-label" for="trial-email">Email</label>
      <input
        id="trial-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="ban@congty.vn"
        required
      />
      <div id="trial-turnstile"></div>
      <button id="trial-submit" type="submit" class="trial-form-submit">Nhận link tải</button>
      <p id="trial-message" class="trial-form-message" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</div>

<script>
  import { SITE_DATA } from '../constants';

  const SITE_KEY = SITE_DATA.trialSiteKey;
  const API_BASE = SITE_DATA.trialApiBase;

  const form = document.getElementById('trial-form');
  const emailInput = document.getElementById('trial-email');
  const submitBtn = document.getElementById('trial-submit');
  const messageEl = document.getElementById('trial-message');
  const turnstileHost = document.getElementById('trial-turnstile');

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  let widgetId = null;
  let pendingToken = null;
  let sending = false;

  function showMessage(text, kind = '') {
    messageEl.textContent = text;
    messageEl.className = 'trial-form-message' + (kind ? ' trial-form-message--' + kind : '');
    messageEl.hidden = false;
  }

  function hideMessage() {
    messageEl.hidden = true;
    messageEl.textContent = '';
  }

  function setBusy(busy) {
    sending = busy;
    submitBtn.disabled = busy;
    submitBtn.textContent = busy ? 'Đang xử lý...' : 'Nhận link tải';
  }

  function turnstileCallback(token) {
    pendingToken = token;
    if (token && sending) doSubmit();
  }

  function turnstileExpired() {
    pendingToken = null;
  }

  function loadTurnstile() {
    if (window.turnstile) {
      widgetId = window.turnstile.render(turnstileHost, {
        sitekey: SITE_KEY,
        callback: turnstileCallback,
        'expired-callback': turnstileExpired,
        'error-callback': turnstileExpired,
        theme: 'auto',
        execution: 'execute',
      });
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.onload = () => {
      widgetId = window.turnstile.render(turnstileHost, {
        sitekey: SITE_KEY,
        callback: turnstileCallback,
        'expired-callback': turnstileExpired,
        'error-callback': turnstileExpired,
        theme: 'auto',
        execution: 'execute',
      });
    };
    document.head.appendChild(script);
  }

  async function doSubmit() {
    const email = emailInput.value.trim();
    const body = { email, turnstileToken: pendingToken };
    try {
      let res = await fetch(`${API_BASE}/api/trial`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      let data = await res.json().catch(() => ({}));

      // Session đã hết: thử renew tự động
      if (data.error === 'session_limit') {
        res = await fetch(`${API_BASE}/api/trial/renew`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        data = await res.json().catch(() => ({}));
      }

      if (res.ok && data.ok) {
        form.hidden = true;
        showMessage('Đã gửi email thành công! Kiểm tra hộp thư để nhận link tải ISO.', 'success');
        return;
      }

      const errors = {
        invalid_email: 'Email không hợp lệ. Vui lòng kiểm tra lại.',
        captcha_failed: 'Xác minh thất bại. Vui lòng thử lại.',
        rate_limited: 'Bạn gửi quá nhanh. Vui lòng thử lại sau vài phút.',
        trial_used: 'Email này đã dùng thử. Vui lòng liên hệ CoreSystem để hỗ trợ.',
        session_limit: 'Email này đã tạo quá nhiều link tải. Vui lòng liên hệ CoreSystem.',
        no_trial: 'Email này chưa đăng ký dùng thử. Vui lòng thử lại.',
        not_ready: 'Tính năng đang được chuẩn bị. Vui lòng quay lại sau.',
        email_failed: 'Gửi email thất bại. Vui lòng thử lại sau.',
      };
      showMessage(errors[data.error] || 'Có lỗi xảy ra. Vui lòng thử lại.', 'error');
    } catch {
      showMessage('Không kết nối được máy chủ. Vui lòng thử lại.', 'error');
    } finally {
      setBusy(false);
      if (widgetId) window.turnstile.reset(widgetId);
      pendingToken = null;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    hideMessage();
    const email = emailInput.value.trim();
    if (!EMAIL_RE.test(email)) {
      showMessage('Email không hợp lệ. Vui lòng kiểm tra lại.', 'error');
      return;
    }
    setBusy(true);
    if (!widgetId) {
      showMessage('Đang khởi tạo xác minh...');
      loadTurnstile();
      // đợi callback; nếu chưa có widget sau khi load, người dùng bấm lại
      setTimeout(() => {
        if (widgetId && !pendingToken && sending) {
          window.turnstile.execute(widgetId);
        } else if (!widgetId) {
          setBusy(false);
          showMessage('Không tải được xác minh. Vui lòng thử lại.', 'error');
        }
      }, 1500);
      return;
    }
    if (pendingToken) {
      doSubmit();
    } else {
      window.turnstile.execute(widgetId);
    }
  });

  loadTurnstile();
</script>