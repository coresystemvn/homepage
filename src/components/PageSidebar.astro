---
// Override PageSidebar — thêm nút ẩn/hiện "On this page" (right TOC).
// khi ẩn: set data-toc-hidden trên <html>, CSS trong starlight.css dời right sidebar + mở rộng content.
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
const locale = (Astro.locals as any)?.starlightRoute?.locale ?? (Astro.url.pathname.startsWith('/en') ? 'en' : 'root');
const isEn = locale === 'en';
const tHide = isEn ? 'Hide table of contents' : 'Ẩn mục lục';
const tShow = isEn ? 'Show table of contents' : 'Hiện mục lục';
const ariaHide = isEn ? 'Hide table of contents (On this page)' : 'Ẩn chỉ mục (On this page)';
const ariaShow = isEn ? 'Show table of contents (On this page)' : 'Hiện chỉ mục (On this page)';
---

{
	Astro.locals.starlightRoute.toc && (
		<>
			<div class="lg:sl-hidden">
				<MobileTableOfContents />
			</div>
			<div class="right-sidebar-panel sl-hidden lg:sl-block">
				<div class="right-sidebar-topbar">
					<button id="toc-toggle" class="toc-toggle" aria-label={ariaHide} aria-pressed="false" title={ariaHide} data-hide={tHide} data-show={tShow} data-aria-hide={ariaHide} data-aria-show={ariaShow}>
						<svg class="toc-toggle-check" viewBox="0 0 20 20" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 10h12M14 6l4 4-4 4"></path>
						</svg>
						<span class="toc-toggle-label">{tHide}</span>
					</button>
				</div>
				<div class="sl-container">
					<TableOfContents />
				</div>
			</div>
		</>
	)
}

<script>
	const btn = document.getElementById('toc-toggle');

	const apply = (hidden) => {
		if (hidden) document.documentElement.setAttribute('data-toc-hidden', '');
		else document.documentElement.removeAttribute('data-toc-hidden');
	};

	const setState = (hidden) => {
		const hide = btn?.dataset.hide || 'Ẩn mục lục';
		const show = btn?.dataset.show || 'Hiện mục lục';
		const ariaHide = btn?.dataset.ariaHide || 'Ẩn chỉ mục (On this page)';
		const ariaShow = btn?.dataset.ariaShow || 'Hiện chỉ mục (On this page)';
		btn?.setAttribute('aria-pressed', String(hidden));
		if (hidden) {
			btn?.setAttribute('title', ariaShow);
			btn?.setAttribute('aria-label', ariaShow);
			document.querySelector('.toc-toggle-label') && (document.querySelector('.toc-toggle-label').textContent = show);
		} else {
			btn?.setAttribute('title', ariaHide);
			btn?.setAttribute('aria-label', ariaHide);
			document.querySelector('.toc-toggle-label') && (document.querySelector('.toc-toggle-label').textContent = hide);
		}
	};

	try {
		if (localStorage.getItem('starlight-toc-hidden') === '1') apply(true);
	} catch {}

	btn?.addEventListener('click', () => {
		const hidden = !document.documentElement.hasAttribute('data-toc-hidden');
		apply(hidden);
		try {
			localStorage.setItem('starlight-toc-hidden', hidden ? '1' : '0');
		} catch {}
		setState(hidden);
	});

	const syncBtn = () => setState(document.documentElement.hasAttribute('data-toc-hidden'));
	syncBtn();
	window.addEventListener('astro:route-change', syncBtn);
</script>

<style>
	@layer starlight.core {
		.right-sidebar-panel {
			padding: 1rem var(--sl-sidebar-pad-x);
		}
		.sl-container {
			width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
		}
		.right-sidebar-panel :global(h2) {
			color: var(--sl-color-white);
			font-size: var(--sl-text-h5);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
			margin-bottom: 0.5rem;
		}
		.right-sidebar-panel :global(:where(a)) {
			display: block;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
			overflow-wrap: anywhere;
		}
		.right-sidebar-panel :global(:where(a):hover) {
			color: var(--sl-color-white);
		}
		.right-sidebar-topbar {
			margin-bottom: 0.75rem;
		}
		.toc-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			padding: 0.25rem 0.4rem;
			border: 1px solid var(--sl-color-hairline);
			border-radius: 0.375rem;
			background: none;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
			cursor: pointer;
			transition: color var(--sl-transition-fast, 0.2s ease), background-color var(--sl-transition-fast, 0.2s ease), border-color var(--sl-transition-fast, 0.2s ease);
		}
		.toc-toggle:hover {
			color: var(--sl-color-white);
			border-color: var(--sl-color-hairline-light);
		}
		@media (min-width: 72rem) {
			.sl-container {
				max-width: calc(
					(
						(
								100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
									var(--sl-sidebar-pad-x)
							) * 0.25 /* MAGIC NUMBER 🥲 */
					)
				);
			}
		}
	}
</style>