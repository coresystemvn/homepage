---
const locale = (Astro.locals as any)?.starlightRoute?.locale ?? (Astro.url.pathname.startsWith('/en') ? 'en' : 'root');
const isEn = locale === 'en';
const label = isEn ? 'Back to home' : 'Quay lại trang chủ';
const href = isEn ? '/en/' : import.meta.env.BASE_URL;
---

<a href={href} class="site-title sl-flex" aria-label={label}>
	<span>{label}</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: var(--sl-nav-gap);
		font-size: var(--sl-text-h4);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	span {
		overflow: hidden;
	}
</style>
