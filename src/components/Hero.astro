---
import { Image } from 'astro:assets';
import SocialIcons from './SocialIcons.astro';
//import portraitImage from '../assets/portrait.png';
import portraitImage from '/public/images/logo.png';
const { name, tagline, twitter, facebook, scholar, email, } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <div class="portrait-container">
      <!--<Image src={portraitImage} alt={name} class="portrait" /> -->
      <img src="/images/logo.png" alt="CORESYSTEM" class="portrait" />
    </div>
    <div class="hero-text">
      <h1>{name}</h1>
      <p class="tagline">{tagline}</p>
      <SocialIcons 
        size={40}
        gap=1.5
        twitter={twitter} 
        facebook={facebook} 
        scholar={scholar} 
        email={email} 
      />
    </div>
  </div>
</section>
