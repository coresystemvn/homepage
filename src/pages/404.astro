---
import Layout from '../layouts/Layout.astro';

const isEn = Astro.url.pathname.startsWith('/en');
const t = isEn
  ? {
      title: '404 - Page Not Found',
      message: 'The page you are looking for does not exist or has been moved.',
      home: 'Back to Home',
      docs: 'EasyDeploy Docs',
    }
  : {
      title: '404 - Không tìm thấy trang',
      message: 'Trang bạn tìm kiếm không tồn tại hoặc đã được di chuyển.',
      home: 'Về trang chủ',
      docs: 'Tài liệu EasyDeploy',
    };
---

<Layout pageTitle={t.title}>
    <div class="page-container">
        <h1>{t.title}</h1>
        <p style="font-size: 4rem; margin: 0;">:(</p>
        <p>{t.message}</p>
        <p style="display: flex; gap: 1rem; justify-content: center;">
            <a class="btn primary" href={isEn ? '/en/' : '/'}>{t.home}</a>
            <a class="btn secondary" href={isEn ? '/en/easydeploy/' : '/easydeploy/'}>{t.docs}</a>
        </p>
    </div>
</Layout>

<style>
    .btn {
        padding: 0.6rem 1.2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }
    .btn.primary { background: var(--color-accent); color: #fff; }
    .btn.secondary { border: 1px solid var(--color-accent); color: var(--color-accent); }
</style>
